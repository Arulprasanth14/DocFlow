# DocFlow Backend — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_VERSION=0.1.0
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ============================================================
# DATABASE (PostgreSQL via PgBouncer)
# ============================================================
DATABASE_URL=postgresql+asyncpg://docflow:docflow@localhost:5432/docflow
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ============================================================
# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048)
# ============================================================
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPLACEHOLDER\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPLACEHOLDER\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================
# FIREBASE (leave empty to disable Firebase auth)
# ============================================================
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=   # path to serviceAccountKey.json OR base64-encoded JSON

# ============================================================
# STORAGE (MinIO for dev, AWS S3 for prod)
# ============================================================
STORAGE_BACKEND=minio         # minio | s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000
S3_BUCKET_DOCUMENTS=docflow-documents
S3_BUCKET_PREVIEWS=docflow-previews
S3_BUCKET_EXPORTS=docflow-exports
S3_BUCKET_OCR_INPUT=docflow-ocr-input
S3_BUCKET_TEMPLATES=docflow-templates

# ============================================================
# AI APIs (leave empty to use mock responses)
# ============================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PRIMARY_MODEL=claude-sonnet-4-5
AI_FALLBACK_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# EMAIL (Resend for prod, Mailpit SMTP for dev)
# ============================================================
EMAIL_FROM=noreply@docflow.local
EMAIL_FROM_NAME=DocFlow
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# ============================================================
# CELERY
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4

# ============================================================
# OBSERVABILITY
# ============================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=docflow-backend
LOG_LEVEL=INFO

# ============================================================
# CORS (comma-separated origins)
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_GLOBAL=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI_CHAT=100/hour
RATE_LIMIT_UPLOADS=5/minute
